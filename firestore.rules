rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/{projectId} {
      allow read: if resource == null 
                  || !('published' in resource.data) 
                  || resource.data.published == true 
                  || (request.auth != null && request.auth.token.email.lower() == 'mohsenjake99@gmail.com');
      allow create, update, delete: if request.auth != null && request.auth.token.email.lower() == 'mohsenjake99@gmail.com';
    }

    match /testimonials/{testimonialId} {
      allow read: if resource == null 
                  || !('status' in resource.data) 
                  || resource.data.status == 'published' 
                  || (request.auth != null && request.auth.token.email.lower() == 'mohsenjake99@gmail.com');
      allow create, update, delete: if request.auth != null && request.auth.token.email.lower() == 'mohsenjake99@gmail.com';
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.token.email.lower() == 'mohsenjake99@gmail.com';
      allow create, update: if request.auth != null && request.auth.token.email.lower() == 'mohsenjake99@gmail.com';
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email.lower() == 'mohsenjake99@gmail.com';
    }
  }
}
